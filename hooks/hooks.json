{
  "description": "Engineering Ops branch guard (opt-in per project via /engineering-ops:engineering -> Workflow setup).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
